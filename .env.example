# GEMINI_API_KEY: Required for Gemini AI API calls if enabled.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: Public URL where the application is hosted.
APP_URL="MY_APP_URL"

# SESSION_SECRET: Secret key used to sign HTTP-only session cookies.
SESSION_SECRET="change-me-to-a-strong-random-secret-key"

# DEVELOPER_2FA_SECRET: Obligatoire (min. 32 car. aléatoires). Clé maître serveur servant au chiffrement AES-256-GCM des secrets TOTP individuels et au hachage des codes de récupération.
DEVELOPER_2FA_SECRET=""

